[Unit]
Description=Mobi QLDN API (520M upload)
After=network.target

[Service]
Type=forking
User=root
WorkingDirectory=/home/mobi/be_doanhnghiep
ExecStart=/bin/sh /home/mobi/be_doanhnghiep/start-api.sh
ExecStop=/bin/sh -c 'fuser -k 8000/tcp || true'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# sudo cp docker/mobi-api.service.example /etc/systemd/system/mobi-api.service
# sudo systemctl daemon-reload && sudo systemctl enable --now mobi-api
